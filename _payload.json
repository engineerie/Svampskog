tion":126,"entries":127,"extension":150,"meta":151,"stem":152,"__hash__":153},"glossary/5.glossary.yml","Ordlista","Grundbegrepp inom svamp och skogsekologi.",[128,134,139,142,147],{"term":129,"definition":130,"aliases":131},"Mykorrhiza","Symbios mellan svamp och växtrötter där svampen hjälper växten att ta upp vatten och näring, och får kolhydrater tillbaka.",[132,133],"ektomykorrhiza","svamprot",{"term":135,"definition":136,"aliases":137},"Hyfer","Mikroskopiskt tunna svamptrådar som bygger upp svampens mycel.",[138],"svamptrådar",{"term":140,"definition":141},"Mycel","Nätverk av hyfer som utgör den största delen av svampen i mark eller ved.",{"term":143,"definition":144,"aliases":145},"Fruktkropp","Den synliga delen av svampen som bildar och sprider sporer.",[146],"svampkropp",{"term":148,"definition":149},"Kalhygge","En yta där nästan alla träd har avverkats, vilket kraftigt förändrar mikroklimat och markförhållanden.","yml",{},"5.glossary","2OMXumbXGEdG5_LRHyGGrqW4JlEr3RWFimVuLZJGW10",{"id":155,"title":156,"body":157,"description":158,"extension":150,"financing":159,"hero":183,"meta":205,"navigation":72,"path":206,"press":207,"sections":220,"seo":238,"stem":239,"timeline":240,"__hash__":265},"index/0.index.yml","Svampskog",null,"Svampskog.se är en webbapplikation där du kan utforska vilka mykorrhizasvampar som kan finnas i olika skogar och se hur de reagerar vid skogsbruksåtgärder.",{"headline":160,"logos":161,"notes":177},"Projektet har finansierats av SLU och Skogssällskapet och med stöd från Skogsstyrelsen och EU.",[162,166,170,174],{"src":163,"alt":164,"height":165},"/images/logo/slu_logo_webb.png","SLU",60,{"src":167,"alt":168,"height":169},"/images/logo/skogssallskapet_logo.png","Skogssällskapet",50,{"src":171,"alt":172,"height":173},"/images/logo/Skogsstyrelsen_logo.png","Skogsstyrelsen",80,{"src":175,"alt":176,"height":173},"/images/logo/EU_Logo.png","EU",[178,179,180,181,182],"Verktyget är utvecklat med data från Markinventeringen, SLU riksskogstaxeringen och SLU Artdatabanken.","Referensgrupp: Representanter från Bitzner, Skogforsk, Skogsstyrelsen, SLU-Artdatabanken, Sveaskog och Södra Skogsägarna.","Ansvarig för projektet och för informationsinnehåll: Anders Dahlberg, SLU","Webb och konceptutveckling: Jacob Bertilsson","Kontakt: Anders Dahlberg, anders.dahlberg@slu.se",{"title":184,"description":185,"links":186,"headline":199,"mykorrhiza":202},"Svampar och skogsskötsel","Utforska mykorrhizasvampar i svenska skogar och se hur de påverkas av skogsskötsel.",[187,195],{"label":188,"icon":189,"trailing":72,"to":190,"target":191,"size":192,"color":193,"variant":194},"Svampar","i-lineicons-mushroom-1","/mykorrhizasvampar","","xl","neutral","solid",{"label":196,"icon":197,"trailing":72,"to":76,"target":191,"size":192,"color":193,"variant":198},"Skogsskötsel","i-hugeicons-tree-06","soft",{"label":191,"to":200,"icon":191,"color":201},"/svampkunskap","secondary",{"title":203,"body":204},"Mykorrhiza är en 500 miljoner år gammal symbios mellan växter och svampar.","Symbiosen innebär att mykorrhizasvamparna får sin energi från träden och i utbyte sköter de om trädens näringsförsörjning.",{},"/",{"title":208,"description":209,"items":210},"Webbinarier","Fördjupa dig i svampar och skogsbruk och ställ dina frågor direkt till forskare.",[211],{"title":212,"publication":164,"publicationDate":213,"url":214,"icon":215,"description":216,"badge":217},"Webbinarium om Svampskog","2026/2027","https://www.slu.se/om-slu/organisation/fakulteter/fakulteten-for-skogsvetenskap/samverkan/kompetensutveckling-for-ett-hallbart-skogsbruk/se-svampen-i-din-skog/","i-heroicons-calendar-date-range","Lär dig mer om skogens mykorrhizasvampar och hur skogsskötsel påverkar dem - och få en genomgång av hur du använder funktionerna i webbappen Svampskog.",{"label":218,"color":219},"Anmäl intresse","info",[221,230],{"title":222,"description":223,"headline":188,"id":224,"links":225,"orientation":228,"reverse":229},"Utforska svampar i svenska skogar","Baserat på DNA-analyser av svampmycel i jordprover och vår samlade kunskap om var olika arters fruktkroppar förekommer.","svampar",[226],{"label":227,"to":190,"icon":189,"color":193,"variant":194,"size":192},"Gå till svampar","horizontal",true,{"title":231,"description":232,"headline":196,"id":233,"src":234,"links":235,"orientation":228,"reverse":72},"Hur påverkar olika skogsskötsel svampar?","Utifrån sammanställd forskning visar vi hur trakthyggesbruk och hyggesfria metoder kan påverka mykorrhizasvampar under en skogsgeneration.","skogsbruk","/images/Landing/Stock Photo 563535222.jpeg",[236],{"label":237,"to":76,"icon":197,"color":193,"variant":194,"size":192},"Gå till skogsskötsel",{"title":156,"description":158},"0.index",{"title":241,"description":242,"items":243},"Kommande innehåll","Svampskog.se vidareutvecklas stegvis med nya funktioner och material.",[244,248,252,255,260],{"date":245,"title":61,"description":246,"icon":247},"Vår 2025","Mjuklansering i samband med Flora och faunavårds-konferansen 9 april. Ett öppet webbinarium om att använda Svampskog hölls den 23 april.","i-hugeicons-plant-01",{"date":249,"title":65,"description":250,"icon":251},"Sommar 2025","Hemsidan mobilanpassades under sommaren 2025.","i-heroicons-sun",{"date":253,"title":196,"description":254,"icon":197},"Vår 2026","Information om skogsskötsel uppdaterades.",{"date":256,"title":257,"description":258,"icon":259},"Sommar 2026","Svampkunskap","Modul för svampkunskap med tillhörande lärarhandledning läggs upp på svampskog.se","i-hugeicons-book-03",{"date":261,"title":262,"description":263,"icon":264},"Höst 2026","Webbinarium","Webbinarium om svampar, skogssbruk och funktionerna på svampskog.se hålls.","i-hugeicons-presentation-line-chart-01","ZrGziXmRjedHaMx3NIwNYzihg0zT7mQzXq4FLIJEdG4",[267,295,341,380,414],{"id":268,"title":269,"body":270,"description":276,"extension":280,"icon":281,"image":282,"impactLabel":157,"impactTone":157,"impactValue":283,"index":283,"meta":284,"methodId":285,"methodTitle":286,"navigation":287,"path":288,"section":289,"sectionIndex":290,"sectionTitle":286,"seo":291,"shortdescription":292,"stem":293,"type":157,"__hash__":294},"skotselmetodSections/2.skogsskotsel/metoder/0.ingen_atgard/0.om_metoden.md","OmMetoden",{"type":271,"value":272,"toc":277},"minimark",[273],[274,275,276],"p",{},"Beståndet lämnas för fri utveckling tills vidare, till exempel som en frivillig naturvårdsavsättning eller en skog med områdesskydd.",{"title":191,"searchDepth":278,"depth":278,"links":279},2,[],"md","i-lucide-trees","images/metoder/ingen_åtgärd.png",0,{},"ingenatgard","Inga åtgärder","test","/skogsskotsel/metoder/ingen_atgard/om_metoden","om_metoden",1,{"title":269,"description":276},"Orörd skog","2.skogsskotsel/metoder/0.ingen_atgard/0.om_metoden","_Vy9ecvrIAfUmbileffbH05EjzPz_cCyTJSxlcu_WX8",{"id":296,"title":269,"body":297,"description":329,"extension":280,"icon":330,"image":331,"impactLabel":157,"impactTone":157,"impactValue":283,"index":290,"meta":332,"methodId":333,"methodTitle":334,"navigation":229,"path":335,"section":289,"sectionIndex":283,"sectionTitle":334,"seo":336,"shortdescription":337,"stem":338,"type":339,"__hash__":340},"skotselmetodSections/2.skogsskotsel/metoder/1.bladning/0.om_metoden.md",{"type":271,"value":298,"toc":327},[299,302,309,315,321],[274,300,301],{},"Blädning innebär ofta uttag om 20-30 procent av virkesvolymen med intervall på 15-30 år.",[303,304,306],"icon-bullet",{"icon":305},"i-lineicons-trees-3",[274,307,308],{},"Avverkning görs med målet att skapa och bibehålla en fullskiktad skog, det vill säga en skog med träd i alla storlekar.",[303,310,312],{"icon":311},"i-heroicons-cloud",[274,313,314],{},"Blädning fungerar bäst med skuggtåliga trädslag, som gran och bok.",[303,316,318],{"icon":317},"i-carbon-soil-moisture-field",[274,319,320],{},"Marken måste vara tillräckligt bördig, för att plantor och småträd ska klara att växa i det slutna beståndet.",[303,322,324],{"icon":323},"i-material-symbols-light-water-drop-outline",[274,325,326],{},"Blädning lämpar sig i skogar där man vill bevara en fuktigare och mer skyddad miljö.",{"title":191,"searchDepth":278,"depth":278,"links":328},[],"Blädning innebär ofta uttag om 20-30 procent av virkesvolymen med intervall på 15-30 år. Avverkning görs med målet att skapa och bibehålla en fullskiktad skog, det vill säga en skog med träd i alla storlekar.","i-tabler-christmas-tree-off","images/metoder/blädning.png",{},"bladning","Blädning","/skogsskotsel/metoder/bladning/om_metoden",{"title":269,"description":329},"Enstaka träd avverkas","2.skogsskotsel/metoder/1.bladning/0.om_metoden","Hyggesfritt","I1LAb59OWt66EIFB0UqSswCSWawA7uRmKisU5MFitR8",{"id":342,"title":269,"body":343,"description":347,"extension":280,"icon":370,"image":371,"impactLabel":157,"impactTone":157,"impactValue":283,"index":278,"meta":372,"methodId":373,"methodTitle":374,"navigation":229,"path":375,"section":289,"sectionIndex":290,"sectionTitle":374,"seo":376,"shortdescription":377,"stem":378,"type":339,"__hash__":379},"skotselmetodSections/2.skogsskotsel/metoder/2.luckhuggning/0.om_metoden.md",{"type":271,"value":344,"toc":368},[345,348,354,360],[274,346,347],{},"Luckhuggning innebär att träd avverkas i luckor med 20-50 m storlek som motsvarar luckor på 500-2 500 m². När ny skog vuxit upp kan luckorna utvidgas eller nya luckor tas upp i beståndet.",[303,349,351],{"icon":350},"i-bx-bxs-chess",[274,352,353],{},"Systematiska former av luckhuggning är schackrutehuggning och kanthuggning.",[303,355,357],{"icon":356},"i-material-symbols-forest-outline",[274,358,359],{},"Luckhuggning fungerar även i enskiktad granskog.",[361,362],"u-alert",{"className":363,"color":365,"title":366,"variant":367},[364],"my-6","tertiary","Luckor större än 2 500 m² räknas som hyggen enligt Skogsstyrelsens definition.","subtle",{"title":191,"searchDepth":278,"depth":278,"links":369},[],"i-pixelarticons:chess","images/metoder/luckhuggning.png",{},"luckhuggning","Luckhuggning","/skogsskotsel/metoder/luckhuggning/om_metoden",{"title":269,"description":347},"Mindre ytor kalavverkas","2.skogsskotsel/metoder/2.luckhuggning/0.om_metoden","SaPemNzAhgcJn4aRMv7Uc-3mOcY9Iz29O9EpJTT0R_8",{"id":381,"title":269,"body":382,"description":386,"extension":280,"icon":404,"image":405,"impactLabel":157,"impactTone":157,"impactValue":283,"index":406,"meta":407,"methodId":408,"methodTitle":409,"navigation":229,"path":410,"section":289,"sectionIndex":290,"sectionTitle":409,"seo":411,"shortdescription":409,"stem":412,"type":339,"__hash__":413},"skotselmetodSections/2.skogsskotsel/metoder/3.skarmtrad/0.om_metoden.md",{"type":271,"value":383,"toc":402},[384,387,393,398],[274,385,386],{},"Överhållen skärm innebär att antalet lämnade skyddande skärmträd är fler än vid en vanlig fröträdsställning och att de sparas längre än vid normalt skärmskogsbruk. Skärmträden avvecklas successivt i flera steg medan trädplantor etableras och växer till.",[303,388,390],{"icon":389},"i-streamline-tree-3",[274,391,392],{},"Tall och bok fungerar bra att föryngra under överhållen skärm. Gran är vindkänsligare och lämpar sig därför sämre.",[303,394,395],{"icon":251},[274,396,397],{},"Överhållen skärm kan vara ett bra val i skogar med naturvärden som vill ha ljus och värme.",[361,399],{"className":400,"color":365,"title":401,"variant":367},[364],"För att räknas som en hyggesfri metod enligt Skogsstyrelsens definition måste minst 25 träd per hektar lämnas att ingå i det nya beståndet.",{"title":191,"searchDepth":278,"depth":278,"links":403},[],"i-lucide-lab-trees-forest","images/metoder/skärm.png",3,{},"skarmtrad","Överhållen skärm","/skogsskotsel/metoder/skarmtrad/om_metoden",{"title":269,"description":386},"2.skogsskotsel/metoder/3.skarmtrad/0.om_metoden","FcgvdIcvzQeLxBTsLxsVPwZ4EuJcv6VrL2wvqWtQupA",{"id":415,"title":269,"body":416,"description":435,"extension":280,"icon":436,"image":437,"impactLabel":157,"impactTone":157,"impactValue":283,"index":438,"meta":439,"methodId":440,"methodTitle":441,"navigation":229,"path":442,"section":289,"sectionIndex":290,"sectionTitle":441,"seo":443,"shortdescription":444,"stem":445,"type":157,"__hash__":446},"skotselmetodSections/2.skogsskotsel/metoder/4.trakthygge/0.om_metoden.md",{"type":271,"value":417,"toc":433},[418,421,427],[274,419,420],{},"Trakthygge är sedan 1950-talet det dominerande skogsskötselsystemet. Det går ut på att skapa likåldriga, större bestånd (trakter), vanligtvis med ett trädslag, och att hela beståndet sköts samtidigt.",[303,422,424],{"icon":423},"i-material-symbols-timeline",[274,425,426],{},"Standardskötseln är: avverkning → markberedning → plantering → röjning → ett par gallringar → åter avverkning efter 60 till 100 år, beroende på bördighet och var i Sverige skogen ligger.",[303,428,430],{"icon":429},"i-ph-farm",[274,431,432],{},"Trakthuggning sker nästan uteslutande med kalavverkning och plantering, alltmer sällsynt med fröträd som avverkas efter plantföryngring skett naturligt.",{"title":191,"searchDepth":278,"depth":278,"links":434},[],"Trakthygge är sedan 1950-talet det dominerande skogsskötselsystemet. Det går ut på att skapa likåldriga, större bestånd (trakter), vanligtvis med ett trädslag, och hela beståndet sköts samtidigt.","i-material-symbols:resize","images/metoder/kalhygge.png",4,{},"trakthygge","Trakthygge","/skogsskotsel/metoder/trakthygge/om_metoden",{"title":269,"description":435},"Kalavverkning med hänsyn","2.skogsskotsel/metoder/4.trakthygge/0.om_metoden","j6T3QUclmgnaajAdHrP_NnEsJ1kQ6uYZ7pmwrf8m3AQ",{"data":448,"body":449},{},{"type":450,"children":451},"root",[452],{"type":453,"tag":274,"props":454,"children":455},"element",{},[456],{"type":457,"value":184},"text",1788205944753]