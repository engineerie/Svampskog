e="103"/><column index="10" value="87"/><column index="11" value="70"/><column index="12" value="54"/><column index="13" value="63"/><column index="14" value="300"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="Species_database" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_"><sort/><column_widths><column index="1" value="67"/><column index="2" value="300"/><column index="3" value="300"/><column index="5" value="262"/><column index="6" value="93"/><column index="7" value="105"/><column index="8" value="83"/><column index="9" value="109"/><column index="10" value="96"/><column index="11" value="92"/><column index="12" value="82"/><column index="13" value="54"/><column index="14" value="58"/><column index="15" value="300"/><column index="16" value="73"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1">SELECT
    h.Taxonid,
    h.Scientificname,
    h.Commonname,
    h.RL2025kat AS correct_category,
    m.RL2025kat AS current_category,
    CASE
        WHEN m.taxon IS NULL THEN 'Needs adding'
        ELSE 'Needs updating'
    END AS required_action
FROM &quot;Hot_och_Ekologi_29_jun_2026&quot; AS h
LEFT JOIN &quot;Mat_Naturvard_Gift_29_jun_2026&quot; AS m
    ON m.taxon = h.Taxonid
WHERE COALESCE(TRIM(m.RL2025kat), '') &lt;&gt;
      COALESCE(TRIM(h.RL2025kat), '')
ORDER BY required_action, h.Scientificname;</sql><current_tab id="0"/></tab_sql></sqlb_project>
