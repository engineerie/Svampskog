description":126,"entries":127,"extension":150,"meta":151,"stem":152,"__hash__":153},"glossary/5.glossary.yml","Ordlista","Grundbegrepp inom svamp och skogsekologi.",[128,134,139,142,147],{"term":129,"definition":130,"aliases":131},"Mykorrhiza","Symbios mellan svamp och växtrötter där svampen hjälper växten att ta upp vatten och näring, och får kolhydrater tillbaka.",[132,133],"ektomykorrhiza","svamprot",{"term":135,"definition":136,"aliases":137},"Hyfer","Mikroskopiskt tunna svamptrådar som bygger upp svampens mycel.",[138],"svamptrådar",{"term":140,"definition":141},"Mycel","Nätverk av hyfer som utgör den största delen av svampen i mark eller ved.",{"term":143,"definition":144,"aliases":145},"Fruktkropp","Den synliga delen av svampen som bildar och sprider sporer.",[146],"svampkropp",{"term":148,"definition":149},"Kalhygge","En yta där nästan alla träd har avverkats, vilket kraftigt förändrar mikroklimat och markförhållanden.","yml",{},"5.glossary","2OMXumbXGEdG5_LRHyGGrqW4JlEr3RWFimVuLZJGW10",{"id":155,"title":156,"body":157,"description":158,"dnaSection":159,"environmentSection":168,"extension":150,"factsSection":171,"fruitbodySection":191,"hero":199,"knowledgeSection":215,"meta":221,"navigation":72,"path":211,"seo":222,"speciesListsIntro":223,"stem":226,"videoSection":227,"__hash__":233},"mykorrhizasvampar/1.mykorrhizasvampar.yml","Svampar",null,"Sök på vilka mykorrhizasvampar som kan finnas i olika skogar baserat på miljö-DNA och sammanställd kunskap om vart fruktkroppar förekommer.",{"headline":160,"title":161,"description":162,"features":163,"image":167},"Enligt DNA","Artförekomst baserad på mycel-DNA i markprover","DNA-analyser görs med små markprover och fungerar utmärkt för frekventa och vanliga arter, men sämre för ovanliga arter. Vissa arter, såsom kantarell, detekteras heller inte eftersom deras DNA-sekvenser är för långa för den använda analysmetoden.",[164],{"title":165,"description":166},"Underlag","Bygger på analyser av svampars förekomst som mycel i ca 2000 markprover tagna i Markinventeringen och Riksskogstaxeringens permanenta provytor i skog under 2015–2021.","/images/Sources/markinventering.png",{"title":169,"description":170},"Välj skogsmiljö","Sök fram skogsmiljöer utifrån Markinventeringens miljövariabler.",{"title":172,"description":173,"items":174},"Lite om mykorrhizasvampar","Korta fakta om mykorrhizasvamparnas mångfald, liv i marken och relation till skogen.",[175,179,183,187],{"title":176,"description":177,"image":178},"Många svampar bildar mykorrhiza","De flesta större svampar i skogen bildar mykorrhiza - nästan alla ätliga och giftiga. Hit hör bland annat spindelskivlingar, kremlor, riskor, soppar och kantareller. Det finns också några som bildar små och oansenliga fruktkroppar och därför dåligt kända, bland annat många skinnsvampar.","/images/Carousel/ManyMychorrhizatone.svg",{"title":180,"description":181,"image":182},"Över 2000 arter i Sverige","I Sverige finns över 2 000 olika mykorrhizasvampar. Några är vanliga, de flesta mindre vanliga eller till och med ovanliga. I en äldre skog kan det finnas ett par hundra arter. Ofta växer varje träds rotsystem i symbios med mycel av 50-100 arter.","/images/Carousel/2000.svg",{"title":184,"description":185,"image":186},"Det mesta är mycel i marken","Fruktkropparna är bara en liten och tillfällig del av svampen. Den största delen är mycel i marken. Mycel växer under hela växtsäsongen och kan leva i många år.","/images/Carousel/MainlyMycelTone.svg",{"title":188,"description":189,"image":190},"Varje mycel är en individ","Varje mycel i marken är en svampindivid, ofta någon till några kvadratmeter stor. I en skog finns många olika individer av både samma och olika arter. Olika individer bildar ett komplext lapptäcke av konkurrerande mycel.","/images/Carousel/patchwork2.svg",{"headline":192,"title":193,"description":194,"features":195,"image":198},"Enligt fruktkroppar","Artförekomst enligt fruktkroppsfynd","Med fruktkroppar kan alla arter som bildar fruktkroppar detekteras, vanliga som ovanliga. Fruktkroppar ger dock en ofullständig bild av artrikedomen och hur vanliga svamparna är, eftersom många arter sällan bildar eller saknar fruktkroppar.",[196],{"title":165,"description":197},"Bygger främst på Artdatabankens sammanställningar av arters förekomst, ekologi och naturvårdsstatus.","/images/Sources/samladkunskap.png",{"title":200,"description":201,"orientation":202,"src":203,"headline":204,"links":207},"Sök svampar i svenska skogar","Baserat på dels DNA-analyser av svamp i markprover och dels uppgifter om var fruktkroppar finns.","vertical","/images/svampbilder/RödlistadeSvampar/Amanita ceciliae-2-37.jpg",{"label":205,"to":205,"icon":205,"color":206},"","secondary",[208],{"label":209,"icon":210,"trailing":72,"to":211,"target":205,"size":212,"color":213,"variant":214},"Sök skogssmiljö","i-lineicons-mushroom-1","/mykorrhizasvampar","xl","neutral","solid",{"title":216,"description":217,"indices":218,"limit":220},"Mer om svampar och deras ekologi","Utvalda kunskapsidor som hjälper dig att förstå svamparna bakom resultaten.",[219],0,3,{},{"title":156,"description":158},{"title":224,"description":225},"Underlag för artlistorna","Här kan du läsa om hur artlistorna tas fram. De bygger på DNA-analyser av jordprover och kunskap om förekomsten av fruktkroppar – två underlag som kompletterar varandra och tillsammans ger en god bild av svamplivet i skogen.","1.mykorrhizasvampar",{"src":228,"subtitles":229,"title":230,"description":231,"image":232},"/videos/svampar.mp4","/videos/svampar.sv.vtt","Kom igång med att utforska skogsmiljöer","En kort genomgång av hur du söker fram olika skogstyper och tolkar artlistorna baserade på DNA och fruktkroppsfynd.","/videos/svampar_poster.png","6Aof1T3Ray9ahKXeWPZe8Y5NIdWRbA6RQLRpzFe2rYE",{"id":155,"title":156,"body":157,"description":158,"dnaSection":235,"environmentSection":238,"extension":150,"factsSection":239,"fruitbodySection":245,"hero":248,"knowledgeSection":252,"meta":254,"navigation":72,"path":211,"seo":255,"speciesListsIntro":256,"stem":226,"videoSection":257,"__hash__":233},{"headline":160,"title":161,"description":162,"features":236,"image":167},[237],{"title":165,"description":166},{"title":169,"description":170},{"title":172,"description":173,"items":240},[241,242,243,244],{"title":176,"description":177,"image":178},{"title":180,"description":181,"image":182},{"title":184,"description":185,"image":186},{"title":188,"description":189,"image":190},{"headline":192,"title":193,"description":194,"features":246,"image":198},[247],{"title":165,"description":197},{"title":200,"description":201,"orientation":202,"src":203,"headline":249,"links":250},{"label":205,"to":205,"icon":205,"color":206},[251],{"label":209,"icon":210,"trailing":72,"to":211,"target":205,"size":212,"color":213,"variant":214},{"title":216,"description":217,"indices":253,"limit":220},[219],{},{"title":156,"description":158},{"title":224,"description":225},{"src":228,"subtitles":229,"title":230,"description":231,"image":232},[259,318],{"id":260,"title":261,"body":262,"description":307,"extension":308,"items":309,"key":310,"meta":311,"navigation":312,"path":313,"sections":314,"seo":315,"stem":316,"underlagbild":271,"__hash__":317},"svamparInfo/svampar/info/0.Underlag.md","Faktaunderlag",{"type":263,"value":264,"toc":301},"minimark",[265,272,277,280,283,286,289,292,295,298],[266,267,268],"p",{},[269,270],"img",{"alt":205,"src":271},"/images/Sources/web/samladkunskap_500.webp",[273,274,276],"h2",{"id":275},"artlistor-på-två-sätt","Artlistor på två sätt",[266,278,279],{},"Vi presenterar artlistor som baseras på (1) DNA-analyser av jordprover och (2) förekomsten av fruktkroppar.",[266,281,282],{},"DNA-analyser görs med små markprover och fungerar utmärkt för frekventa och vanliga arter, men dåligt för ovanliga arter.",[266,284,285],{},"Med fruktkroppar kan däremot alla arter som bildar fruktkroppar detekteras, vanliga som ovanliga. Fruktkroppar ger dock också en ofullständig bild av artrikedomen och hur vanliga svamparna är, eftersom många arter sällan bildar eller saknar fruktkroppar.",[266,287,288],{},"De två metoderna kompletterar varandra och ger tillsammans en god bild av svamplivet i skogen.",[273,290,160],{"id":291},"enligt-dna",[266,293,294],{},"Bygger på DNA-analyser av svampars förekomst som mycel från ca 2000 markprover tagna i Markinventeringen och Riksskogstaxeringen permanenta provytor i skog under 2015-2021.",[273,296,192],{"id":297},"enligt-fruktkroppar",[266,299,300],{},"Bygger främst på Artdatabankens sammanställningar över arters förekomst, ekologi och naturvårdsstatus.",{"title":205,"searchDepth":302,"depth":302,"links":303},2,[304,305,306],{"id":275,"depth":302,"text":276},{"id":291,"depth":302,"text":160},{"id":297,"depth":302,"text":192},"Kombination av svamp-DNA i mark och kunskap om fruktkroppar","md",[],"underlag",{},true,"/svampar/info/underlag",[],{"title":261,"description":307},"svampar/info/0.Underlag","cp2F6ke2Coe76Kv82QsBNkGIzaMWp_aV4hSPBPaSPww",{"id":319,"title":172,"body":320,"description":205,"extension":308,"items":368,"key":369,"meta":370,"navigation":312,"path":371,"sections":372,"seo":373,"stem":374,"underlagbild":157,"__hash__":375},"svamparInfo/svampar/info/1.Fakta.md",{"type":263,"value":321,"toc":362},[322,326,329,331,334,339,341,344,349,351,354,359],[273,323,325],{"id":324},"många-skogssvampar-bildar-mykorrhiza","Många skogssvampar bildar mykorrhiza",[266,327,328],{},"![](/images/svampindex/Cortinarius sanguineus-179-.jpg)",[266,330,177],{},[273,332,180],{"id":333},"över-2000-arter-i-sverige",[266,335,336],{},[269,337],{"alt":205,"src":338},"/images/Carousel/web/ArterDiagram2.webp",[266,340,181],{},[273,342,184],{"id":343},"det-mesta-är-mycel-i-marken",[266,345,346],{},[269,347],{"alt":205,"src":348},"/images/Carousel/web/mainlymycelium.webp",[266,350,185],{},[273,352,188],{"id":353},"varje-mycel-är-en-individ",[266,355,356],{},[269,357],{"alt":205,"src":358},"/images/Carousel/web/S%C3%B6der_Tallskog_91_Bl%C3%A5b%C3%A4r_grupp.webp",[266,360,361],{},"Varje mycel i marken är en svampindivid, ofta någon till några kvadratmeter stor. I en skog finns många olika individer av både samma och olika arter. Olika individe bildar ett komplext lapptäcke av konkurrerande mycel.",{"title":205,"searchDepth":302,"depth":302,"links":363},[364,365,366,367],{"id":324,"depth":302,"text":325},{"id":333,"depth":302,"text":180},{"id":343,"depth":302,"text":184},{"id":353,"depth":302,"text":188},[],"fakta",{},"/svampar/info/fakta",[],{"title":172,"description":205},"svampar/info/1.Fakta","qsmV0XZv4g1sq4rpOHDD669Y5EMq1hHErSSZjfXvhQY",1788205945694]